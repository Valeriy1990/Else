'''Стохастический градиентный спуск'''

import numpy as np

# исходная функция, которую нужно аппроксимировать моделью a(x)
def func(x):
    return 0.5 * x**2 - 0.1 * 1/np.exp(-x) + 0.5 * np.cos(2*x) - 2.

def L(x, y, w):
    return ((w.T @ x) - y)**2 

coord_x = np.arange(-5.0, 5.0, 0.1) # значения по оси абсцисс [-5; 5] с шагом 0.1
X = np.array([(1, x, x**2, np.cos(2*x), np.sin(2*x)) for x in coord_x])
Y = np.array(func(coord_x)) # значения функции по оси ординат

sz = len(coord_x)	# количество значений функций (точек)
eta = np.array([0.01, 0.001, 0.0001, 0.01, 0.01]) # шаг обучения для каждого параметра w0, w1, w2, w3, w4
w = np.array([0., 0., 0., 0., 0.]) # начальные значения параметров модели
N = 500 # число итераций алгоритма SGD
lm = 0.02 # значение параметра лямбда для вычисления скользящего экспоненциального среднего

Qe = np.sum(L(X.T, Y, w))/sz   # начальное значение среднего эмпирического риска
np.random.seed(0) # генерация одинаковых последовательностей псевдослучайных чисел

while(N > 0):
    k = np.random.randint(0, sz) # sz - размер выборки (массива coord_x)
    grad = 2 * ((w @ X[k].T) - Y[k]) * X[k]
    w = w - eta * grad
    Qe = lm * (L(X[k], Y[k], w)) + (1 - lm) * Qe
    N -= 1

Q = np.sum(L(X.T, Y, w))/sz
